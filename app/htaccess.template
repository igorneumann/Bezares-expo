# =====================================================================
#  PLANTILLA del .htaccess raíz. NO subir/editar /.htaccess a mano:
#  la aplicación lo genera automáticamente a partir de este fichero
#  (sustituyendo {{GATE}}) cada vez que cambia esta plantilla.
# =====================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS: activar en Plesk "Redirección 301 permanente de HTTP a HTTPS"
# (Hosting y DNS > Configuración de hosting). No se hace aquí para evitar
# bucles detrás del proxy nginx.

# La carpeta .well-known (Let's Encrypt) siempre accesible y sin más reglas
RewriteRule ^\.well-known/ - [END]

# /cookie.html autoriza el dispositivo automáticamente (lo atiende cookie.php)
RewriteRule ^cookie\.html$ cookie.php [END]

# Bloquear ficheros internos / ocultos
RewriteRule ^(_app|app|data)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^_boot\.php$ - [F,L]

# Carpeta de medios: nunca servir código ni páginas (aunque faltara media/.htaccess)
RewriteRule ^{{MEDIA}}/.*\.(php\d?|phtml|phar|pht|cgi|pl|py|sh|shtml|html?|xhtml|js|mjs)$ - [F,L]

# ---- Puerta de acceso por cookie de dispositivo ----------------------
{{GATE}}

# Router: todo lo que no sea fichero real va a index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "(?i)\.(sqlite|sqlite3|sqlite-wal|sqlite-shm|db|log|ini|sh|sql|bak|old|orig|swp|dist|md|lock|key|part|tmp)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(config|config\.sample)\.php$">
    Require all denied
</FilesMatch>

# ---- Tipos MIME --------------------------------------------------------
<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType model/gltf+json .gltf
    AddType application/wasm .wasm
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
    AddType image/avif .avif
    AddType image/webp .webp
    AddType video/mp4 .mp4 .m4v
    AddType video/webm .webm
    AddType text/javascript .js .mjs
</IfModule>

# ---- Compresión ----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml model/gltf+json model/gltf-binary application/wasm application/manifest+json text/plain
</IfModule>

# ---- Caché del navegador ---------------------------------------------------
# Todos los recursos estáticos se enlazan con ?v=<versión>, así que pueden
# guardarse "para siempre": cuando cambian, cambia la URL.
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    # X-Frame-Options / frame-ancestors los envía PHP en cada página (lista de sitios de
    # confianza configurable en el panel); aquí no se fuerza para no bloquear el iframe.
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    <FilesMatch "(?i)\.(css|js|mjs|wasm|svg|png|jpe?g|gif|webp|avif|ico|glb|gltf|bin|obj|mtl|stp|step|mp4|m4v|webm|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Medios: aunque faltara media/.htaccess, un fichero subido nunca se ejecuta como página.
    <If "%{REQUEST_URI} =~ m#^/{{MEDIA}}/#">
        Header set Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; media-src 'self'; sandbox"
    </If>
    <FilesMatch "^(sw\.js|cookie\.html|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
    # Worker del conversor STEP: OpenCascade/embind necesita 'unsafe-eval'. Sólo se permite
    # en este worker (aislado, sin acceso al DOM), nunca en las páginas.
    <FilesMatch "^occt-worker\.js$">
        Header set Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self'"
    </FilesMatch>
</IfModule>
